#################################################################
#    Class: Player
#################################################################

###  http://example.org/pkmnTCG#Player
pkmnTCG:Player rdfs:subClassOf bgo:Player ;
               rdfs:comment "Il giocatore nel TCG Pokémon, mappato al concetto generico di Player della BGO."@it .


###  Proprietà collegate a Player
pkmnTCG:hasZone rdf:type owl:ObjectProperty ;
                rdfs:domain pkmnTCG:Player ;
                rdfs:range pkmnTCG:Zone .


#################################################################
#    Class: Pokemon
#################################################################

###  http://example.org/pkmnTCG#Pokemon
pkmnTCG:Pokemon rdf:type owl:Class ;
                rdfs:comment "Un'entità concettuale, come Charizard, che può avere più carte rappresentative."@it ;
                rdfs:label "Pokémon entity"@en ;
                rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Pok%C3%A9mon_(TCG)> .


#################################################################
#    Class: Set
#################################################################

###  http://example.org/pkmnTCG#Set
pkmnTCG:Set rdf:type owl:Class ;
            rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Pok%C3%A9mon_Trading_Card_Game#International_sets> .


#################################################################
#    Class: Status
#################################################################

###  http://example.org/pkmnTCG#Status
pkmnTCG:Status rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( pkmnTCG:Asleep
                                                 pkmnTCG:Burned
                                                 pkmnTCG:Confused
                                                 pkmnTCG:Paralyzed
                                                 pkmnTCG:Poisoned
                                               )
                                   ] ;
               rdfs:comment "Pokémon status conditions in the TCG."@en ;
               rdfs:label "Status Condition"@en ;
               rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Special_Condition_(TCG)> .


###  Individui di Status
pkmnTCG:Asleep rdf:type owl:NamedIndividual ,
                        pkmnTCG:Status ;
               rdfs:label "Asleep"@en ;
               rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Sleep_(status_condition)#In_the_TCG> .


pkmnTCG:Burned rdf:type owl:NamedIndividual ,
                        pkmnTCG:Status ;
               rdfs:label "Burned"@en ;
               rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Burn_(status_condition)#In_the_TCG> .


pkmnTCG:Confused rdf:type owl:NamedIndividual ,
                          pkmnTCG:Status ;
                 rdfs:label "Confused"@en ;
                 rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Special_Condition_(TCG)#Confused> .


pkmnTCG:Paralyzed rdf:type owl:NamedIndividual ,
                           pkmnTCG:Status ;
                  rdfs:label "Paralyzed"@en ;
                  rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Paralysis_(status_condition)#In_the_TCG> .


pkmnTCG:Poisoned rdf:type owl:NamedIndividual ,
                          pkmnTCG:Status ;
                 rdfs:label "Poisoned"@en ;
                 rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Poison_(status_condition)#In_the_TCG> .


#################################################################
#    General Axioms
#################################################################


# Una property chain che realizza Deck -> Entry -> Card
pkmnTCG:hasCardInDeck a owl:ObjectProperty ;
  rdfs:subPropertyOf bgo:hasCard ;
  owl:propertyChainAxiom ( pkmnTCG:hasDeckEntry pkmnTCG:entryCard ) ;
  rdfs:comment "Se un Deck ha una DeckEntry e quella DeckEntry ha una entryCard, allora il Deck haCard quella carta."@it .


#################################################################
#    Classi di inferenza
#################################################################


pkmnTCG:hasBasicPokemon rdf:type owl:Class ;
                      rdfs:subClassOf pkmnTCG:Deck ;
                      rdfs:comment "Una classe che raggruppa tutti i mazzi che contengono almeno un Pokémon Base."@it .

pkmnTCG:hasValidEffect rdf:type owl:Class ;
                      rdfs:subClassOf pkmnTCG:TrainerCard ;
                      rdfs:comment "Una classe che raggruppa tutte le carte Trainer che hanno un effetto valido."@it .

pkmnTCG:InvalidBasicEnergyCard rdf:type owl:Class ;
                               rdfs:subClassOf pkmnTCG:EnergyCard ;
                               rdfs:comment "Una classe che raggruppa le carte Energia di tipo Base che violano la regola di non avere effetti."@it .

pkmnTCG:InvalidEvolvePokemonAction rdf:type owl:Class ;
                                   rdfs:subClassOf pkmnTCG:EvolvePokemonAction ;
                                   rdfs:comment "Una classe che raggruppa le azioni di evoluzione che sono considerate non valide."@it .

pkmnTCG:ValidPlayAbilityAction rdf:type owl:Class ;
                               rdfs:subClassOf pkmnTCG:PlayAbilityAction ;
                               rdfs:comment "Una classe che raggruppa le azioni di abilità che sono considerate valide."@it .

pkmnTCG:InvalidGameAction rdf:type owl:Class ;
                         rdfs:subClassOf pkmnTCG:GameAction ;
                         rdfs:comment "Una classe che raggruppa le azioni di gioco che non sono state eseguite dal giocatore attivo."@it .

pkmnTCG:PokemonInInvalidZone rdf:type owl:Class ;
                             rdfs:subClassOf pkmnTCG:PokemonCard ;
                             rdfs:comment "Una classe che raggruppa i Pokémon che hanno carte attaccate in una zona non di gioco."@it .

pkmnTCG:InvalidPlayStadiumAction rdf:type owl:Class ;
                                 rdfs:subClassOf pkmnTCG:PlayCardAction ;
                                 rdfs:comment "Una classe che raggruppa le azioni di gioco di una carta Stadio in una zona diversa dalla GameZone."@it .

