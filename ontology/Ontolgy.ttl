                        skos:Concept ;
               rdfs:label "Dragon"@en ;
               rdfs:seeAlso <https://bulbapedia.bulbagarden.net/wiki/Dragon_Energy_card_(TCG)> ;
               skos:inScheme pkmnTCG:EnergyConceptScheme .


